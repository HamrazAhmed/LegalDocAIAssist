# LegalDocAiAssist Environment Variables Template
# Copy this file to .env and set your Google Gemini API key:
# cp .env.example .env

# Google Gemini API Key (Obtain from https://aistudio.google.com/)
GEMINI_API_KEY=

# Configurable Gemini Model (Default: gemini-2.5-flash)
# Supported options: gemini-2.5-flash, gemini-2.5-pro
GEMINI_MODEL=gemini-2.5-flash
